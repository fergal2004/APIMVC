@{
ViewData["Title"] = ViewBag.NombreChatbot;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.NombreChatbot</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <style>
        /* Estilos personalizados */
        body {
            background: linear-gradient(135deg, #b4c1cd, #829cb5, #6482a0);
            background-size: cover;
            background-repeat: no-repeat;
            background-attachment: fixed;
            font-family: 'Inter', sans-serif;
        }

        .chat-container {
            max-width: 800px;
            margin: 30px auto;
            background-color: rgba(255, 255, 255, 0.95);
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            padding: 25px;
        }

        .chat-header {
            background: linear-gradient(to right, #6a11cb, #2575fc);
            color: white;
            padding: 20px;
            border-radius: 12px 12px 0 0;
            text-align: center;
            margin-bottom: 30px;
        }

        .chat-header h1 {
            font-size: 28px;
            font-weight: 600;
            letter-spacing: 1px;
        }

        .team-card-container {
            display: flex;
            justify-content: space-around;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .team-card {
            border: none;
            padding: 20px;
            border-radius: 10px;
            text-align: center;
            width: calc(32% - 20px);
            background-color: rgba(233, 236, 239, 0.8);
            transition: transform 0.3s, box-shadow 0.3s;
            margin-bottom: 20px;
        }

        .team-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
        }

        .team-card img {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
            margin-bottom: 15px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .team-card h3 {
            font-size: 18px;
            font-weight: 600;
            color: #343a40;
            margin-bottom: 10px;
        }

        .team-card p {
            font-size: 14px;
            color: #6c757d;
            margin-bottom: 5px;
        }

        .chat-messages {
            margin-bottom: 30px;
            padding: 20px;
            border: 1px solid #ddd;
            border-radius: 12px;
            background-color: rgba(249, 249, 249, 0.8);
            height: 350px;
            overflow-y: auto;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
        }

        .message {
            padding: 12px 15px;
            border-radius: 10px;
            margin-bottom: 15px;
            clear: both;
            opacity: 0;
            animation: fadeIn 0.5s forwards;
        }

        keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .user-message {
            background-color: #007bff;
            color: white;
            float: right;
            border-bottom-right-radius: 0;
        }

        .bot-message {
            background-color: #e0e0e0;
            color: #333;
            float: left;
            border-bottom-left-radius: 0;
        }

        .chat-input-area {
            display: flex;
            margin-bottom: 30px;
        }

        .chat-input {
            flex-grow: 1;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 6px 0 0 6px;
            font-size: 16px;
            transition: border-color 0.3s;
        }

        .chat-input:focus {
            outline: none;
            border-color: #007bff;
            box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.1);
        }

        .send-button {
            background: linear-gradient(to right, #4CAF50, #388E3C);
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 0 6px 6px 0;
            cursor: pointer;
            transition: background 0.3s, transform 0.2s;
        }

        .send-button:hover {
            background: linear-gradient(to right, #66BB6A, #43A047);
            transform: translateY(-2px);
        }

        .chat-footer {
            text-align: center;
            margin-top: 30px;
            color: #6c757d;
            font-size: 14px;
        }

        .error-message {
            color: #dc3545;
            margin-top: 15px;
            text-align: center;
            padding: 10px;
            background-color: #f8d7da;
            border-radius: 6px;
            border: 1px solid #f5c6cb;
        }

        .success-message {
            color: #155724;
            margin-top: 15px;
            text-align: center;
            padding: 10px;
            background-color: #d4edda;
            border-radius: 6px;
            border: 1px solid #c3e6cb;
        }
    </style>
</head>
<body>
<div class="chat-container">
    <div class="chat-header">
        <h1>@ViewBag.NombreChatbot</h1>
    </div>

    <div class="team-card-container">
        <div class="team-card">
            <img src="~/Imagenes/Fernando Galindo.jpg" class="rounded-circle" alt="Miembro 1">
            <h3>Fernando Galindo</h3>
            <p>Correo: fernando.galindo@udla.edu.ec</p>
            <p>Intereses: Futbol, Musica</p>
        </div>
        <div class="team-card">
            <img src="~/Imagenes/Juan Feijoo.jpeg" class="rounded-circle" alt="Miembro 2">
            <h3>Juan Feijoo</h3>
            <p>Correo: juan.feijoo@udla.edu.ec</p>
            <p>Intereses: Me gustan las mujeres, salir de fiesta y ser fiel a una sola mujer. Y el COD</p>
        </div>
        <div class="team-card">
            <img src="~/Imagenes/Michelle Reyes.jpeg" class="rounded-circle" alt="Miembro 3">
            <h3>Michelle Reyes</h3>
            <p>Correo: michelle.reyes.delgado@udla.edu.ec</p>
            <p>Intereses: Jugar volley</p>
        </div>
    </div>

    <div class="chat-messages" id="chatMessages">
        @if (!string.IsNullOrEmpty(ViewBag.Pregunta))
        {
        <div class="message user-message">
            <p><strong>Tú:</strong> @ViewBag.Pregunta</p>
        </div>
        <div class="message bot-message">
            <p><strong>@ViewBag.NombreChatbot:</strong> @Html.Raw(ViewBag.Respuesta)</p>
        </div>
        @if (ViewBag.GuardadoExitoso == true)
        {
        <div class="success-message">Respuesta guardada.</div>
        }
        else if (ViewBag.GuardadoExitoso == false)
        {
        <div class="error-message">Error al guardar la respuesta.</div>
        }
        }
        @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
        {
        <div class="error-message">@ViewBag.ErrorMessage</div>
        }
    </div>

    <form asp-controller="Chatbot" asp-action="Preguntar" method="post" class="chat-input-area">
        <input type="text" id="pregunta" name="pregunta" class="form-control chat-input" placeholder="Escribe tu pregunta...">
        <button type="submit" class="btn btn-primary send-button">Enviar</button>
    </form>

    <div class="chat-footer">
        <p>&copy; @DateTime.Now.Year - Galindo BOT</p>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/popperjs/core@2.5.3/dist/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<script>
    // Función para hacer scroll al final de los mensajes
    $(document).ready(function () {
        var chatMessages = $("#chatMessages");
        chatMessages.scrollTop(chatMessages.prop("scrollHeight"));
    });
</script>
</body>
</html>
